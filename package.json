{
  "name": "organotiko-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["apps/organotiko", "packages/domain"],
  "scripts": {
    "dev": "npm run dev -w @organotiko/app",
    "build": "npm run build -w @organotiko/app",
    "test": "node --test packages/domain/*.test.mjs tests/*.test.mjs",
    "typecheck": "npm run typecheck -w @organotiko/app",
    "check": "npm run test && npm run build"
  },
  "engines": {"node": ">=22"}
}
